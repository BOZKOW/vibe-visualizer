# Starts Vibe Bridge when you log in (Linux, systemd user service). Install:
#   mkdir -p ~/.config/systemd/user && cp vibe-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now vibe-bridge
# It expects the program at ~/.local/bin/vibe-bridge (change ExecStart if it's elsewhere).
[Unit]
Description=Vibe Bridge (computer sound for Vibe Visualizer)
After=pipewire-pulse.service pulseaudio.service

[Service]
ExecStart=%h/.local/bin/vibe-bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
